@inproceedings{ngo2023heston,
  abbr = {VEO},
  title = {Calibration and Option Pricing of the Heston Model: An Empirical Analysis with Deep Learning},
  author = {Tôn Nữ, Triệu Mẫn and Ngô, Thiện Mỹ and Hồ, Ngọc Phương Trinh and Nguyễn, Gia An},
  booktitle = veo,
  year = {2023},
  abstract = {We calibrate the Heston stochastic volatility model, priced with the COS Fourier method, on the full chain of SPX options in 2022. Heston–COS fits market prices about ten times better than Black–Scholes (RMSE 0.43% vs 4.05%). We then train a neural network to learn the map from model parameters to prices, and run it in reverse to calibrate. The network reaches R² = 0.991, showing that a fast learned pricer can replace a slower numerical solver for calibration.},
  html = {https://lilyngo22.github.io/assets/heston-cos-deep-learning.html},
  award = {2nd Prize, Vietnam National Olympiad in Econometrics; 1st Prize, IU Student Scientific Conference 2023},
  selected = {true},
  bibtex_show = {true}
}

@thesis{ngo2024quantum,
  abbr = {BSC. Thesis},
  title = {Quantum versus Classical: A Study of the Heston Model in Option Pricing},
  author = {Ngô, Thiện Mỹ},
  school = {International University – VNU-HCM},
  type = {B.Sc. thesis},
  year = {2024},
  abstract = {This thesis builds a quantum circuit that prices European call options under the Heston stochastic-volatility model. Heston parameters are first calibrated classically with FFT pricing on December 2023 SPX options, then fed into a 7-qubit circuit that loads discretised variance and price distributions, encodes the call payoff into an ancilla amplitude, and reads the price with Iterative Quantum Amplitude Estimation. On a simulator the quantum prices reach MAE 20.23 and RMSE 29.03 index points against market prices. The study runs the full pipeline end to end and shows that, at today's qubit counts, discretisation error dominates the theoretical quadratic speed-up of amplitude estimation.},
  html = {https://lilyngo22.github.io/assets/quantum-vs-classical-heston.html},
  selected = {true},
  bibtex_show = {true}
}

@inproceedings{pham2025kan,
  abbr = {VSEFI},
  title = {From Traditional Statistical Model to Modern Deep Learning: A Multi-Horizon Study of Stock Market Prediction in Vietnam},
  author = {Pham, Minh-Chau and Nguyen-Le, Dang-Khoa and Ngô, Thiện Mỹ},
  booktitle = {Vietnam Symposium in Entrepreneurship, Finance and Innovation (VSEFI)},
  year = {2025},
  abstract = {We compare ARIMA, XGBoost, MLP, LSTM, Kolmogorov–Arnold Networks (KAN), ARIMA + neural-network hybrids and a horizon-weighted ensemble for forecasting the VN-Index and four HoSE stocks (VCB, FPT, HPG, SSI) at horizons of 1, 3, 5 and 20 trading days, using 2,543 sessions from 2014 to 2024. ARIMA is best one day ahead, while the ensemble leads at longer horizons. KAN, even in a basic configuration, matches MLP and outperforms LSTM, and ARIMA–neural hybrids underperform at long horizons, contrary to evidence from developed markets. This is the first evaluation of KAN on the Vietnamese stock market.},
  html = {https://lilyngo22.github.io/assets/kan-vietnam-forecasting.html},
  selected = {true},
  bibtex_show = {true}
}

@inproceedings{ngo2025raclinucb,
  abbr = {ACBES},
  title = {Adaptive Portfolio Optimization in the Vietnamese Stock Market: A Contextual Multi-Armed Bandit with Markov-Switching Regimes},
  author = {Ngô, Thiện Mỹ and Nguyen-Le, Dang-Khoa and Pham, Minh-Chau},
  booktitle = {7th Asia Conference on Business and Economic Studies (ACBES 2025)},
  year = {2025},
  abstract = {We propose RAC-LinUCB, a regime-aware contextual bandit for portfolio selection in emerging markets. Regime probabilities from a two-state Markov-switching model enter both the context and a meta-adaptive exploration term that widens or narrows LinUCB's confidence bound with market regime and volatility while preserving optimism under uncertainty. A differentiable multi-objective reward combines annualised return, downside risk, benchmark-relative alpha and the Treynor ratio, with weights tuned by CMA-ES. On the 50 largest HoSE stocks (June 2021 – June 2025), RAC-LinUCB reaches a Sharpe ratio of 2.15 in-sample and 2.76 out-of-sample, outperforming Equal-Weight, Markowitz and the VN-Index, and limits drawdown to 14.6% through the 2025 tariff shock.},
  html = {https://lilyngo22.github.io/assets/rac-linucb-portfolio.html},
  selected = {true},
  bibtex_show = {true}
}
