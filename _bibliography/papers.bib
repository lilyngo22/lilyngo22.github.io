@inproceedings{ngo2023heston,
  abbr = {VEO},
  title = {Calibration and Option Pricing of the Heston Model: An Empirical Analysis with Deep Learning},
  author = {Tôn Nữ, Triệu Mẫn and Ngô, Thiện Mỹ and Hồ, Ngọc Phương Trinh and Nguyễn, Gia An},
  booktitle = veo,
  year = {2023},
  abstract = {We calibrate the Heston stochastic volatility model, priced with the COS Fourier method, on the full chain of SPX options in 2022. Heston–COS fits market prices about ten times better than Black–Scholes (RMSE 0.43% vs 4.05%). We then train a neural network to learn the map from model parameters to prices, and run it in reverse to calibrate. The network reaches R² = 0.991, showing that a fast learned pricer can replace a slower numerical solver for calibration.},
  html = {https://lilyngo22.github.io/assets/heston-cos-deep-learning.html},
  award = {2nd Prize, Vietnam National Olympiad in Econometrics; 1st Prize, IU Student Scientific Conference 2023},
  selected = {true},
  bibtex_show = {true}
}
